# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=
STORAGE_DIR=./storage
FRONTEND_PORT=5173
# Blank derives explicit localhost and 127.0.0.1 origins from FRONTEND_PORT.
# Otherwise use a comma-separated list of exact HTTP(S) origins; wildcard is rejected.
CORS_ALLOWED_ORIGINS=
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=500
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_openrouter_model_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2
EXTRACTION_CHUNK_CHARS=12000
EXTRACTION_CHUNK_OVERLAP=1000
EXTRACTION_MAX_CHUNKS=120
POSTGRES_PASSWORD=replace_with_a_local_development_password
